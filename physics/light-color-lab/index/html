<script src="../../toolbox-nav.js"></script>
<script>
(function(){
"use strict";

/* ============================================================
   공통: 색 이름 붙이기
   ============================================================ */
var NAMES = [
  ["검은색",        0,   0,   0  ],
  ["흰색",          255, 255, 255],
  ["빨간색",        255, 0,   0  ],
  ["초록색",        0,   255, 0  ],
  ["파란색",        0,   0,   255],
  ["노란색",        255, 255, 0  ],
  ["청록색(사이안)",0,   255, 255],
  ["자홍색(마젠타)",255, 0,   255],
  ["회색",          128, 128, 128],
  ["주황색",        255, 128, 0  ],
  ["연두색",        128, 255, 0  ],
  ["하늘색",        0,   160, 255],
  ["보라색",        128, 0,   255],
  ["분홍색",        255, 150, 190],
  ["진분홍색",      255, 0,   128],
  ["민트색",        0,   255, 160],
  ["어두운 빨강",   110, 0,   0  ],
  ["어두운 초록",   0,   110, 0  ],
  ["어두운 파랑",   0,   0,   110],
  ["갈색",          130, 70,  25 ],
  ["짙은 회색",     60,  60,  60 ]
];
function colorName(r,g,b){
  var best=NAMES[0], bd=Infinity;
  for(var i=0;i<NAMES.length;i++){
    var n=NAMES[i];
    var d=(r-n[1])*(r-n[1])+(g-n[2])*(g-n[2])+(b-n[3])*(b-n[3]);
    if(d<bd){bd=d;best=n;}
  }
  return best[0];
}
function css(r,g,b){return "rgb("+Math.round(r)+","+Math.round(g)+","+Math.round(b)+")";}

/* ============================================================
   탭 전환
   ============================================================ */
var tabs=[].slice.call(document.querySelectorAll('.tab'));
function showTab(id){
  tabs.forEach(function(t){
    var on = (t.id===id);
    t.setAttribute('aria-selected', on?'true':'false');
    document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
  });
  if(id==='tab-mix') drawMix();
  if(id==='tab-pixel') drawPix();
  if(id==='tab-obj') drawObj();
}
tabs.forEach(function(t,i){
  t.addEventListener('click',function(){showTab(t.id);});
  t.addEventListener('keydown',function(e){
    var k=e.key, j=-1;
    if(k==='ArrowRight') j=(i+1)%tabs.length;
    if(k==='ArrowLeft')  j=(i-1+tabs.length)%tabs.length;
    if(j>=0){e.preventDefault();tabs[j].focus();showTab(tabs[j].id);}
  });
});

/* ============================================================
   상단 버튼
   ============================================================ */
var teacherBtn=document.getElementById('teacherBtn');
teacherBtn.addEventListener('click',function(){
  var on = teacherBtn.getAttribute('aria-pressed')==='true';
  teacherBtn.setAttribute('aria-pressed', on?'false':'true');
  document.body.classList.toggle('teacher-on', !on);
});
document.getElementById('saveBtn').addEventListener('click',function(){
  var sel=tabs.filter(function(t){return t.getAttribute('aria-selected')==='true';})[0].id;
  var cv = sel==='tab-mix'?mixCv : (sel==='tab-pixel'?pixCv:objCv);
  var nm = sel==='tab-mix'?'빛의합성' : (sel==='tab-pixel'?'화면픽셀':'물체의색');
  try{
    var a=document.createElement('a');
    a.download=nm+'.png'; a.href=cv.toDataURL('image/png');
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
  }catch(err){ alert('이 브라우저에서는 저장이 막혀 있습니다. 화면을 캡처해 주세요.'); }
});

/* ============================================================
   ① 빛의 합성
   ============================================================ */
var mixCv=document.getElementById('mixCanvas');
var mx=mixCv.getContext('2d');
var W=800, H=500;                       /* 그리기용 논리 좌표계 */
mixCv.width=W*2; mixCv.height=H*2; mx.scale(2,2);

var lights={r:true,g:true,b:true};
var gap=52, soft=false, showNames=true;
var R=125;                               /* 빛 동그라미 반지름 */
var basePos={};                          /* 간격 슬라이더로 계산된 기본 위치 */
var dragOff={r:null,g:null,b:null};      /* 사용자가 끌어 옮긴 위치 */

function computeBase(){
  var cx=W/2, cy=H/2+10;
  var d=(gap/100)*130;                   /* 중심에서 떨어진 거리 */
  basePos.r={x:cx,           y:cy-d};
  basePos.g={x:cx-d*0.866,   y:cy+d*0.5};
  basePos.b={x:cx+d*0.866,   y:cy+d*0.5};
}
function posOf(k){ return dragOff[k] || basePos[k]; }

function drawMix(){
  computeBase();
  /* 배경: 어두운 방 + 스크린 */
  mx.clearRect(0,0,W,H);
  mx.fillStyle='#101014'; mx.fillRect(0,0,W,H);
  var sx=60, sy=36, sw=W-120, sh=H-110;
  mx.fillStyle='#1b1b21';
  roundRect(mx,sx,sy,sw,sh,14); mx.fill();
  mx.strokeStyle='#3a3a44'; mx.lineWidth=2; mx.stroke();
  /* 스크린 받침 */
  mx.fillStyle='#2a2a33';
  mx.fillRect(sx+sw*0.28, sy+sh, sw*0.44, 10);
  mx.fillStyle='#8b8b98';
  mx.font='600 13px Pretendard, sans-serif'; mx.textAlign='left';
  mx.fillText('어두운 방 · 하얀 스크린 (빛이 없으면 검게 보입니다)', sx+12, sy+22);

  /* 빛 그리기 (겹치면 더해지도록 lighter 사용) */
  mx.save();
  roundRect(mx,sx,sy,sw,sh,14); mx.clip();
  mx.globalCompositeOperation='lighter';
  ['r','g','b'].forEach(function(k){
    if(!lights[k]) return;
    var p=posOf(k);
    var base = k==='r'?[255,40,40] : k==='g'?[40,255,80] : [60,110,255];
    if(soft){
      var gd=mx.createRadialGradient(p.x,p.y,4,p.x,p.y,R);
      gd.addColorStop(0,   'rgb('+base[0]+','+base[1]+','+base[2]+')');
      gd.addColorStop(0.55,'rgba('+base[0]+','+base[1]+','+base[2]+',0.72)');
      gd.addColorStop(1,   'rgba('+base[0]+','+base[1]+','+base[2]+',0)');
      mx.fillStyle=gd;
    }else{
      mx.fillStyle='rgb('+base[0]+','+base[1]+','+base[2]+')';
    }
    mx.beginPath(); mx.arc(p.x,p.y,R,0,Math.PI*2); mx.fill();
  });
  mx.restore();

  /* 꺼진 손전등 자리 점선 표시 */
  mx.save();
  mx.globalCompositeOperation='source-over';
  ['r','g','b'].forEach(function(k){
    if(lights[k]) return;
    var p=posOf(k);
    mx.setLineDash([6,7]); mx.lineWidth=1.5; mx.strokeStyle='rgba(190,190,205,.42)';
    mx.beginPath(); mx.arc(p.x,p.y,R,0,Math.PI*2); mx.stroke();
    mx.setLineDash([]);
    mx.fillStyle='rgba(190,190,205,.62)'; mx.font='600 12px Pretendard, sans-serif';
    mx.textAlign='center'; mx.fillText('꺼짐', p.x, p.y+4);
  });
  mx.restore();

  if(showNames) drawRegionLabels();
  drawTorches();
  updateLegend();
}

/* 영역 이름표 */
function drawRegionLabels(){
  var on=['r','g','b'].filter(function(k){return lights[k];});
  if(!on.length) return;
  var cands=[];
  function centroid(keys){
    var x=0,y=0; keys.forEach(function(k){x+=posOf(k).x;y+=posOf(k).y;});
    return {x:x/keys.length,y:y/keys.length};
  }
  /* 단독 영역 */
  on.forEach(function(k){
    var others=on.filter(function(o){return o!==k;});
    var p=posOf(k), t;
    if(!others.length){ t={x:p.x,y:p.y}; }
    else{
      var c=centroid(others);
      var dx=p.x-c.x, dy=p.y-c.y, L=Math.hypot(dx,dy)||1;
      t={x:p.x+dx/L*R*0.55, y:p.y+dy/L*R*0.55};
    }
    cands.push({members:[k], pt:t});
  });
  /* 두 개 겹침 */
  for(var i=0;i<on.length;i++) for(var j=i+1;j<on.length;j++){
    var a=on[i], b=on[j];
    var m=centroid([a,b]);
    var rest=on.filter(function(o){return o!==a&&o!==b;});
    if(rest.length){
      var c2=posOf(rest[0]);
      var dx2=m.x-c2.x, dy2=m.y-c2.y, L2=Math.hypot(dx2,dy2)||1;
      m={x:m.x+dx2/L2*R*0.42, y:m.y+dy2/L2*R*0.42};
    }
    cands.push({members:[a,b], pt:m});
  }
  /* 세 개 겹침 */
  if(on.length===3) cands.push({members:on.slice(), pt:centroid(on)});

  cands.forEach(function(c){
    /* 그 점이 정말 그 영역 안인지 확인 */
    var ok=true;
    on.forEach(function(k){
      var p=posOf(k), d=Math.hypot(c.pt.x-p.x, c.pt.y-p.y);
      var inside = d<=R-6;
      if(c.members.indexOf(k)>=0){ if(!inside) ok=false; }
      else { if(d<=R+2) ok=false; }
    });
    if(!ok) return;
    var v=mixOf(c.members);
    label(c.pt.x, c.pt.y, colorName(v[0],v[1],v[2]));
  });
}
function label(x,y,text){
  mx.save();
  mx.font='700 13px Pretendard, sans-serif';
  mx.textAlign='center'; mx.textBaseline='middle';
  var w=mx.measureText(text).width+16;
  mx.fillStyle='rgba(255,255,255,.90)';
  roundRect(mx, x-w/2, y-12, w, 24, 12); mx.fill();
  mx.strokeStyle='rgba(0,0,0,.25)'; mx.lineWidth=1; mx.stroke();
  mx.fillStyle='#141414'; mx.fillText(text, x, y+1);
  mx.restore();
}
function mixOf(keys){
  var r=0,g=0,b=0;
  keys.forEach(function(k){ if(k==='r')r=255; if(k==='g')g=255; if(k==='b')b=255; });
  return [r,g,b];
}

/* 손전등 3개 그림 */
function drawTorches(){
  var y=H-4;                      /* 손전등 아래쪽 기준선 */
  var spots=[{k:'r',x:W/2-140,c:'#ff3b3b',n:'빨강'},{k:'g',x:W/2,c:'#2ade6f',n:'초록'},{k:'b',x:W/2+140,c:'#4a83ff',n:'파랑'}];
  spots.forEach(function(s){
    var on=lights[s.k];
    mx.save();
    /* 몸통 (스크린을 향해 세워 둔 모습) */
    mx.fillStyle= on? '#4a4a56':'#32323b';
    roundRect(mx, s.x-12, y-32, 24, 32, 6); mx.fill();
    /* 렌즈 */
    mx.fillStyle= on? s.c : '#585863';
    roundRect(mx, s.x-11, y-43, 22, 12, 3); mx.fill();
    /* 빛다발 */
    if(on){
      mx.globalAlpha=.5; mx.fillStyle=s.c;
      mx.beginPath();
      mx.moveTo(s.x-11,y-43); mx.lineTo(s.x-23,y-60); mx.lineTo(s.x+23,y-60); mx.lineTo(s.x+11,y-43);
      mx.closePath(); mx.fill();
      mx.globalAlpha=1;
    }
    /* 색 이름 (색만으로 구분하지 않도록) */
    mx.fillStyle= on? '#dcdce8' : '#75757f';
    mx.font='700 11px Pretendard, sans-serif'; mx.textAlign='center';
    mx.fillText(s.n, s.x, y-6);
    mx.restore();
  });
}
function roundRect(c,x,y,w,h,r){
  c.beginPath();
  c.moveTo(x+r,y); c.arcTo(x+w,y,x+w,y+h,r); c.arcTo(x+w,y+h,x,y+h,r);
  c.arcTo(x,y+h,x,y,r); c.arcTo(x,y,x+w,y,r); c.closePath();
}

/* 보이는 색 목록 */
function updateLegend(){
  var on=['r','g','b'].filter(function(k){return lights[k];});
  var ul=document.getElementById('mixLegend');
  ul.innerHTML='';
  if(!on.length){
    ul.innerHTML='<li><span class="sw" style="background:#111"></span>손전등이 모두 꺼져 있습니다 — 스크린은 <b>검은색</b>으로 보입니다.</li>';
    return;
  }
  var sets=[];
  on.forEach(function(k){sets.push([k]);});
  for(var i=0;i<on.length;i++) for(var j=i+1;j<on.length;j++) sets.push([on[i],on[j]]);
  if(on.length===3) sets.push(on.slice());
  var kor={r:'빨간색',g:'초록색',b:'파란색'};
  sets.forEach(function(s){
    var v=mixOf(s);
    var li=document.createElement('li');
    li.innerHTML='<span class="sw" style="background:'+css(v[0],v[1],v[2])+'"></span>'+
      '<span>'+s.map(function(k){return kor[k];}).join(' + ')+' → <b>'+colorName(v[0],v[1],v[2])+'</b></span>'+
      '<span class="rgb">('+v[0]+', '+v[1]+', '+v[2]+')</span>';
    ul.appendChild(li);
  });
}

/* 조작 연결 */
[].slice.call(document.querySelectorAll('.lamp')).forEach(function(btn){
  btn.addEventListener('click',function(){
    var k=btn.dataset.c;
    lights[k]=!lights[k];
    btn.setAttribute('aria-pressed', lights[k]?'true':'false');
    btn.querySelector('.state').textContent = lights[k]?'켜짐':'꺼짐';
    drawMix();
  });
});
var gapEl=document.getElementById('gap');
gapEl.addEventListener('input',function(){
  gap=+gapEl.value; document.getElementById('gapVal').textContent=gap+' %';
  dragOff={r:null,g:null,b:null};
  drawMix();
});
var softBtn=document.getElementById('softBtn');
softBtn.addEventListener('click',function(){
  soft=!soft; softBtn.setAttribute('aria-pressed', soft?'true':'false'); drawMix();
});
var nameBtn=document.getElementById('nameBtn');
nameBtn.addEventListener('click',function(){
  showNames=!showNames; nameBtn.setAttribute('aria-pressed', showNames?'true':'false'); drawMix();
});
document.getElementById('resetBtn').addEventListener('click',function(){
  dragOff={r:null,g:null,b:null}; gap=52; gapEl.value=52;
  document.getElementById('gapVal').textContent='52 %'; drawMix();
});

/* 끌어 옮기기 (키보드로는 간격 슬라이더로 조작) */
var dragging=null;
function toLocal(e){
  var rect=mixCv.getBoundingClientRect();
  return {x:(e.clientX-rect.left)/rect.width*W, y:(e.clientY-rect.top)/rect.height*H};
}
mixCv.addEventListener('pointerdown',function(e){
  var p=toLocal(e), best=null, bd=1e9;
  ['r','g','b'].forEach(function(k){
    if(!lights[k]) return;
    var c=posOf(k), d=Math.hypot(p.x-c.x,p.y-c.y);
    if(d<R && d<bd){bd=d;best=k;}
  });
  if(best){ dragging=best; mixCv.setPointerCapture(e.pointerId); }
});
mixCv.addEventListener('pointermove',function(e){
  if(!dragging) return;
  var p=toLocal(e);
  dragOff[dragging]={x:Math.max(70,Math.min(W-70,p.x)), y:Math.max(56,Math.min(H-90,p.y))};
  drawMix();
});
mixCv.addEventListener('pointerup',function(){dragging=null;});
mixCv.addEventListener('pointercancel',function(){dragging=null;});

/* ============================================================
   ② 화면 속 픽셀
   ============================================================ */
var pixCv=document.getElementById('pixCanvas');
var px=pixCv.getContext('2d');
var PW=450, PH=310;
pixCv.width=PW*2; pixCv.height=PH*2; px.scale(2,2);
var sR=document.getElementById('sR'), sG=document.getElementById('sG'), sB=document.getElementById('sB');

function pixVals(){ return [+sR.value, +sG.value, +sB.value]; }
function drawPix(){
  var v=pixVals();
  document.getElementById('vR').textContent=v[0];
  document.getElementById('vG').textContent=v[1];
  document.getElementById('vB').textContent=v[2];
  var nm=colorName(v[0],v[1],v[2]);
  var sw=document.getElementById('pixSwatch');
  sw.style.background=css(v[0],v[1],v[2]);
  document.getElementById('pixName').textContent=nm;
  document.getElementById('pixCode').textContent='지금 색: '+nm+' ('+v[0]+', '+v[1]+', '+v[2]+')';

  px.clearRect(0,0,PW,PH);
  px.fillStyle='#0d0d11'; px.fillRect(0,0,PW,PH);

  /* 왼쪽: 멀리서 본 화면 */
  px.fillStyle='#8b8b98'; px.font='600 12px Pretendard, sans-serif'; px.textAlign='left';
  px.fillText('멀리서 본 화면', 16, 22);
  px.fillStyle=css(v[0],v[1],v[2]);
  roundRect(px,16,32,150,110,10); px.fill();
  px.strokeStyle='#3a3a44'; px.lineWidth=2; px.stroke();

  /* 확대 표시선 */
  px.strokeStyle='rgba(160,160,180,.5)'; px.setLineDash([5,5]); px.lineWidth=1.5;
  px.beginPath(); px.moveTo(166,50); px.lineTo(200,32);
  px.moveTo(166,124); px.lineTo(200,278); px.stroke(); px.setLineDash([]);

  /* 오른쪽: 확대한 픽셀 */
  px.fillStyle='#8b8b98'; px.fillText('아주 크게 확대한 모습 (픽셀 6개)', 200, 22);
  var cols=3, rows=2, cw=76, ch=118, ox=204, oy=32;
  for(var i=0;i<cols;i++) for(var j=0;j<rows;j++){
    var x=ox+i*(cw+8), y=oy+j*(ch+10);
    px.fillStyle='#1a1a20'; roundRect(px,x,y,cw,ch,5); px.fill();
    var sub=[[v[0],0,0],[0,v[1],0],[0,0,v[2]]];
    for(var s=0;s<3;s++){
      var c=sub[s];
      px.fillStyle='rgb('+c[0]+','+c[1]+','+c[2]+')';
      roundRect(px, x+5+s*((cw-10)/3), y+6, (cw-10)/3-4, ch-12, 3); px.fill();
    }
  }
  /* 알갱이 설명 (색만으로 구분하지 않도록 글자와 숫자도 표시) */
  var names=['빨강','초록','파랑'];
  var chipCols=[[255,60,60],[60,235,110],[80,130,255]];
  px.font='700 12px Pretendard, sans-serif'; px.textAlign='left';
  for(var s2=0;s2<3;s2++){
    var bx=210+s2*82, by=PH-22;
    px.fillStyle='rgb('+chipCols[s2][0]+','+chipCols[s2][1]+','+chipCols[s2][2]+')';
    roundRect(px,bx,by-9,11,11,3); px.fill();
    px.fillStyle='#c9c9d6';
    px.fillText(names[s2]+' '+v[s2], bx+16, by);
  }
  px.fillStyle='#7f7f8c'; px.font='600 11px Pretendard, sans-serif';
  px.fillText('알갱이 3개가 모여 한 칸(픽셀)', 16, PH-22);
}
[sR,sG,sB].forEach(function(s){ s.addEventListener('input',drawPix); });

/* 프리셋 */
var PRESETS=[['흰색',255,255,255],['노란색',255,255,0],['청록색(사이안)',0,255,255],['자홍색(마젠타)',255,0,255],
             ['주황색',255,128,0],['하늘색',0,160,255],['보라색',128,0,255],['회색',128,128,128],['검은색',0,0,0]];
var pbox=document.getElementById('presets');
PRESETS.forEach(function(p){
  var b=document.createElement('button');
  b.className='preset'; b.type='button';
  b.innerHTML='<span class="sw" style="background:'+css(p[1],p[2],p[3])+'"></span>'+p[0];
  b.addEventListener('click',function(){ sR.value=p[1]; sG.value=p[2]; sB.value=p[3]; drawPix(); });
  pbox.appendChild(b);
});

/* 색 만들기 도전 */
var TARGETS=[['노란색',255,255,0],['청록색(사이안)',0,255,255],['자홍색(마젠타)',255,0,255],
             ['흰색',255,255,255],['주황색',255,128,0],['하늘색',0,160,255],['보라색',128,0,255],['회색',128,128,128]];
var target=null;
function newTarget(){
  var t;
  do{ t=TARGETS[Math.floor(Math.random()*TARGETS.length)]; }while(target && t[0]===target[0]);
  target=t;
  document.getElementById('targetSwatch').style.background=css(t[1],t[2],t[3]);
  document.getElementById('targetName').textContent=t[0];
  document.getElementById('pixFb').className='feedback';
}
document.getElementById('pixNext').addEventListener('click',newTarget);
document.getElementById('pixCheck').addEventListener('click',function(){
  var v=pixVals();
  var d=Math.max(Math.abs(v[0]-target[1]),Math.abs(v[1]-target[2]),Math.abs(v[2]-target[3]));
  var fb=document.getElementById('pixFb');
  if(d<=40){ fb.className='feedback show good'; fb.textContent='정답! '+target[0]+'을(를) 만들었습니다. 켜져 있는 알갱이를 다시 확인해 보세요.'; }
  else{
    var tips=[];
    if(v[0]<target[1]-40) tips.push('빨강을 더 밝게'); if(v[0]>target[1]+40) tips.push('빨강을 더 어둡게');
    if(v[1]<target[2]-40) tips.push('초록을 더 밝게'); if(v[1]>target[2]+40) tips.push('초록을 더 어둡게');
    if(v[2]<target[3]-40) tips.push('파랑을 더 밝게'); if(v[2]>target[3]+40) tips.push('파랑을 더 어둡게');
    fb.className='feedback show bad';
    fb.textContent='아직 아니에요. '+tips.join(', ')+' 해 보세요.';
  }
});

/* ============================================================
   ③ 물체의 색
   ============================================================ */
var objCv=document.getElementById('objCanvas');
var ox_=objCv.getContext('2d');
var OW=750, OH=440;
objCv.width=OW*2; objCv.height=OH*2; ox_.scale(2,2);
/* 물체마다 '빛이 부딪히는 윗면'의 높이 (중심에서 위로 얼마나) */
var TOPOF={apple:-48, leaf:-32, ball:-52, banana:-18, paper:-58};

var LIGHTS=[
  {id:'w', name:'하얀 빛(백색광)', rgb:[255,255,255]},
  {id:'r', name:'빨간 빛',        rgb:[255,0,0]},
  {id:'g', name:'초록 빛',        rgb:[0,255,0]},
  {id:'b', name:'파란 빛',        rgb:[0,0,255]},
  {id:'y', name:'노란 빛',        rgb:[255,255,0]},
  {id:'m', name:'자홍 빛',        rgb:[255,0,255]},
  {id:'c', name:'청록 빛',        rgb:[0,255,255]}
];
var OBJECTS=[
  {id:'apple',  name:'빨간 사과',   refl:[0.90,0.10,0.10], shape:'apple'},
  {id:'leaf',   name:'초록 잎',     refl:[0.10,0.80,0.15], shape:'leaf'},
  {id:'ball',   name:'파란 공',     refl:[0.10,0.15,0.90], shape:'ball'},
  {id:'banana', name:'노란 바나나', refl:[0.95,0.85,0.10], shape:'banana'},
  {id:'paper',  name:'흰 종이',     refl:[0.95,0.95,0.95], shape:'paper'},
  {id:'cloth',  name:'검은 천',     refl:[0.06,0.06,0.06], shape:'paper'}
];
var curLight=LIGHTS[0], curObj=OBJECTS[0];

function buildChips(){
  var lc=document.getElementById('lightChips');
  LIGHTS.forEach(function(L){
    var b=document.createElement('button');
    b.className='chip'; b.type='button';
    b.setAttribute('aria-pressed', L===curLight?'true':'false');
    b.innerHTML='<span class="sw" style="background:'+css(L.rgb[0],L.rgb[1],L.rgb[2])+'"></span>'+L.name;
    b.addEventListener('click',function(){
      curLight=L;
      [].slice.call(lc.children).forEach(function(c){c.setAttribute('aria-pressed','false');});
      b.setAttribute('aria-pressed','true'); drawObj();
    });
    lc.appendChild(b);
  });
  var oc=document.getElementById('objChips');
  OBJECTS.forEach(function(O){
    var b=document.createElement('button');
    b.className='chip'; b.type='button';
    b.setAttribute('aria-pressed', O===curObj?'true':'false');
    var c=[O.refl[0]*255,O.refl[1]*255,O.refl[2]*255];
    b.innerHTML='<span class="sw" style="background:'+css(c[0],c[1],c[2])+'"></span>'+O.name;
    b.addEventListener('click',function(){
      curObj=O;
      [].slice.call(oc.children).forEach(function(c2){c2.setAttribute('aria-pressed','false');});
      b.setAttribute('aria-pressed','true'); drawObj();
    });
    oc.appendChild(b);
  });
  /* 교사용 반사율 표 */
  var t=document.getElementById('reflTable');
  var html='<tr><th class="rowhead">물체</th><th>빨강 반사</th><th>초록 반사</th><th>파랑 반사</th></tr>';
  OBJECTS.forEach(function(O){
    html+='<tr><th class="rowhead">'+O.name+'</th>'+O.refl.map(function(x){return '<td>'+Math.round(x*100)+'%</td>';}).join('')+'</tr>';
  });
  t.innerHTML=html;
}
buildChips();

function seenColor(){
  var L=curLight.rgb, F=curObj.refl;
  return [L[0]*F[0], L[1]*F[1], L[2]*F[2]];
}

function drawObj(){
  var seen=seenColor();
  var isDark = (seen[0]+seen[1]+seen[2])/3 < 26;
  var lightCss=css(curLight.rgb[0],curLight.rgb[1],curLight.rgb[2]);

  ox_.clearRect(0,0,OW,OH);
  ox_.fillStyle='#101014'; ox_.fillRect(0,0,OW,OH);

  /* 전등 · 물체 · 눈의 자리
     전등과 눈을 물체 중심의 수직선 기준으로 좌우 대칭에 놓았기 때문에
     물체를 바꿔 부딪히는 높이가 달라져도 빛이 꺾이는 모양이 늘 자연스럽게 나온다. */
  var cx=OW/2, cy=300;
  var P   ={x:cx, y:cy + (TOPOF[curObj.shape]||-50)};   /* 빛이 부딪히는 점 */
  var lamp={x:172, y:106};
  var eye ={x:OW-172, y:106};

  /* 전등에서 나온 빛 → 물체 */
  ray(lamp, P, 26, 6, lightCss, 5, false);
  var m1=mid(lamp,P);
  txt(ox_,'비춘 빛', m1.x+34, m1.y-20, '#c6c6d4','600 12px');

  /* 물체 */
  drawShape(ox_, curObj, cx, cy, seen);
  txt(ox_, curObj.name, cx, cy+96, '#d5d5e2','700 13px');

  /* 흡수 표시 */
  var absorbed=[];
  var Lr=curLight.rgb, F=curObj.refl, kor=['빨강','초록','파랑'];
  for(var i=0;i<3;i++){ if(Lr[i]>10 && F[i]<0.4) absorbed.push(kor[i]); }
  txt(ox_, absorbed.length? ('흡수: '+absorbed.join('·')+' 빛') : '거의 모두 반사',
      cx, cy+118, '#9a9aa8','600 12px');

  /* 물체 → 눈 */
  var m2=mid(P,eye);
  if(isDark){
    ray(P, eye, 6, 34, 'rgba(150,150,165,.5)', 3, true);
    txt(ox_,'반사된 빛 거의 없음', m2.x+20, m2.y+50, '#9a9aa8','600 12px');
  }else{
    ray(P, eye, 6, 34, css(seen[0],seen[1],seen[2]), 5, false);
    txt(ox_,'반사된 빛', m2.x-34, m2.y-20, '#c6c6d4','600 12px');
  }

  /* 전등과 눈 */
  drawLamp(lamp, lightCss, curLight.rgb);
  txt(ox_, curLight.name, lamp.x, lamp.y+58, '#d5d5e2','700 13px');
  drawEye(ox_, eye.x, eye.y, seen, isDark);
  txt(ox_,'보이는 색: '+colorName(seen[0],seen[1],seen[2]), eye.x, eye.y+58, '#e6e6f0','700 13px');

  updateObjExplain(seen, isDark, absorbed);
}

function mid(a,b){ return {x:(a.x+b.x)/2, y:(a.y+b.y)/2}; }

/* 두 점을 잇는 화살표 (양 끝을 조금 잘라서 그림에 겹치지 않게) */
function ray(from,to,trimA,trimB,color,w,dashed){
  var dx=to.x-from.x, dy=to.y-from.y, L=Math.hypot(dx,dy)||1;
  var ux=dx/L, uy=dy/L;
  var x1=from.x+ux*trimA, y1=from.y+uy*trimA;
  var x2=to.x-ux*trimB,   y2=to.y-uy*trimB;
  ox_.save();
  if(dashed) ox_.setLineDash([8,9]);
  ox_.strokeStyle=color; ox_.fillStyle=color; ox_.lineWidth=w; ox_.lineCap='round';
  ox_.beginPath(); ox_.moveTo(x1,y1); ox_.lineTo(x2-ux*13, y2-uy*13); ox_.stroke();
  ox_.setLineDash([]);
  var px=-uy, py=ux;                      /* 화살촉 */
  ox_.beginPath();
  ox_.moveTo(x2,y2);
  ox_.lineTo(x2-ux*16+px*9, y2-uy*16+py*9);
  ox_.lineTo(x2-ux*16-px*9, y2-uy*16-py*9);
  ox_.closePath(); ox_.fill();
  ox_.restore();
}

/* 천장에 매달린 전등 */
function drawLamp(p, colorCss, rgb){
  var on = (rgb[0]+rgb[1]+rgb[2])>0;
  ox_.save();
  /* 빛 번짐 */
  if(on){
    var gd=ox_.createRadialGradient(p.x,p.y,4,p.x,p.y,62);
    gd.addColorStop(0,colorCss); gd.addColorStop(1,'rgba(0,0,0,0)');
    ox_.globalAlpha=.42; ox_.fillStyle=gd;
    ox_.beginPath(); ox_.arc(p.x,p.y,62,0,Math.PI*2); ox_.fill();
    ox_.globalAlpha=1;
  }
  /* 전선 */
  ox_.strokeStyle='#4c4c58'; ox_.lineWidth=3;
  ox_.beginPath(); ox_.moveTo(p.x,0); ox_.lineTo(p.x,p.y-56); ox_.stroke();
  /* 갓 */
  ox_.beginPath();
  ox_.moveTo(p.x-12,p.y-56); ox_.lineTo(p.x+12,p.y-56);
  ox_.lineTo(p.x+40,p.y-12); ox_.lineTo(p.x-40,p.y-12);
  ox_.closePath();
  ox_.fillStyle='#4a4a56'; ox_.fill();
  ox_.strokeStyle='#6a6a78'; ox_.lineWidth=2; ox_.stroke();
  /* 갓 안쪽 */
  ox_.fillStyle= on? colorCss : '#33333c';
  ox_.globalAlpha= on? .35 : 1;
  ox_.beginPath();
  ox_.moveTo(p.x-38,p.y-14); ox_.lineTo(p.x+38,p.y-14);
  ox_.lineTo(p.x+34,p.y-20); ox_.lineTo(p.x-34,p.y-20);
  ox_.closePath(); ox_.fill(); ox_.globalAlpha=1;
  /* 전구 */
  ox_.fillStyle= on? colorCss : '#3f3f49';
  ox_.beginPath(); ox_.arc(p.x,p.y-2,14,0,Math.PI*2); ox_.fill();
  ox_.strokeStyle='rgba(255,255,255,.28)'; ox_.lineWidth=1.5; ox_.stroke();
  ox_.restore();
}

function txt(c,s,x,y,color,font){
  c.save(); c.fillStyle=color; c.font=(font||'600 12px')+' Pretendard, sans-serif';
  c.textAlign='center'; c.fillText(s,x,y); c.restore();
}
function arrow(c,x1,y1,x2,y2,color,w){
  c.save(); c.strokeStyle=color; c.fillStyle=color; c.lineWidth=w; c.lineCap='round';
  c.beginPath(); c.moveTo(x1,y1); c.lineTo(x2-12,y2); c.stroke();
  c.beginPath(); c.moveTo(x2,y2); c.lineTo(x2-15,y2-9); c.lineTo(x2-15,y2+9); c.closePath(); c.fill();
  c.restore();
}
function drawShape(c,O,x,y,seen){
  var col=css(seen[0],seen[1],seen[2]);
  c.save();
  c.strokeStyle='rgba(210,210,225,.55)'; c.lineWidth=2; c.fillStyle=col;
  if(O.shape==='apple'){
    c.beginPath(); c.arc(x,y+4,52,0,Math.PI*2); c.fill(); c.stroke();
    c.strokeStyle='rgba(160,140,110,.8)'; c.lineWidth=5;
    c.beginPath(); c.moveTo(x,y-46); c.quadraticCurveTo(x+8,y-66,x+20,y-70); c.stroke();
  }else if(O.shape==='leaf'){
    c.beginPath();
    c.moveTo(x-58,y); c.quadraticCurveTo(x,y-62,x+58,y); c.quadraticCurveTo(x,y+62,x-58,y);
    c.closePath(); c.fill(); c.stroke();
    c.strokeStyle='rgba(0,0,0,.28)'; c.lineWidth=2;
    c.beginPath(); c.moveTo(x-52,y); c.lineTo(x+52,y); c.stroke();
  }else if(O.shape==='ball'){
    c.beginPath(); c.arc(x,y,52,0,Math.PI*2); c.fill(); c.stroke();
    c.strokeStyle='rgba(0,0,0,.22)'; c.lineWidth=2;
    c.beginPath(); c.ellipse(x,y,20,52,0,0,Math.PI*2); c.stroke();
  }else if(O.shape==='banana'){
    c.beginPath();
    c.moveTo(x-56,y-18); c.quadraticCurveTo(x,y+58,x+56,y-18);
    c.quadraticCurveTo(x,y+26,x-56,y-18); c.closePath(); c.fill(); c.stroke();
  }else{
    roundRect(c,x-48,y-58,96,116,6); c.fill(); c.stroke();
    c.strokeStyle='rgba(0,0,0,.18)'; c.lineWidth=1.5;
    for(var i=1;i<5;i++){ c.beginPath(); c.moveTo(x-34,y-40+i*20); c.lineTo(x+34,y-40+i*20); c.stroke(); }
  }
  c.restore();
}
function drawEye(c,x,y,seen,dark){
  c.save();
  c.fillStyle='#f2efe8'; c.strokeStyle='#5a5a66'; c.lineWidth=2;
  c.beginPath();
  c.moveTo(x-40,y); c.quadraticCurveTo(x,y-30,x+40,y); c.quadraticCurveTo(x,y+30,x-40,y);
  c.closePath(); c.fill(); c.stroke();
  c.fillStyle= dark? '#2b2b33' : css(seen[0]*0.85,seen[1]*0.85,seen[2]*0.85);
  c.beginPath(); c.arc(x,y,15,0,Math.PI*2); c.fill();
  c.fillStyle='#15151a'; c.beginPath(); c.arc(x,y,6,0,Math.PI*2); c.fill();
  c.restore();
}

function updateObjExplain(seen, isDark, absorbed){
  var name=colorName(seen[0],seen[1],seen[2]);
  var kor=['빨강','초록','파랑'];
  var reflected=[];
  for(var i=0;i<3;i++){ if(curLight.rgb[i]>10 && curObj.refl[i]>=0.4) reflected.push(kor[i]); }
  var html='<b>'+curLight.name+'</b> 아래에서 <b>'+curObj.name+'</b>은(는) <strong>'+name+'</strong>으로 보입니다.<br>';
  if(isDark){
    if(curObj.id==='cloth'){
      html+='검은 천은 비춘 빛을 거의 모두 흡수합니다. 반사되어 눈으로 오는 빛이 없으니 검게 보입니다.';
    }else{
      var can=[];
      for(var k=0;k<3;k++){ if(curObj.refl[k]>=0.4) can.push(kor[k]); }
      html+=curObj.name+'이(가) 반사할 수 있는 것은 <b>'+can.join('·')+' 빛</b>인데, 지금 비추는 빛에는 그 색이 없습니다. 반사할 빛 자체가 없으니 <b>검게</b> 보입니다.';
    }
  }else{
    html+='비춘 빛 중 <b>'+(reflected.join('·')||'일부')+' 빛</b>이 반사되어 눈으로 들어왔습니다.';
    if(absorbed.length) html+=' 나머지 <b>'+absorbed.join('·')+' 빛</b>은 물체가 흡수했습니다.';
  }
  html+='<br><span style="color:#6d675e;font-size:14px">보이는 색 = 비춘 빛 ('+curLight.rgb.join(', ')+') × 반사 비율 ('+curObj.refl.map(function(x){return Math.round(x*100)+'%';}).join(', ')+')</span>';
  document.getElementById('objExplain').innerHTML=html;
}

/* ============================================================
   시작
   ============================================================ */
drawMix(); drawPix(); newTarget(); drawObj();
window.addEventListener('beforeprint',function(){ drawMix(); drawPix(); drawObj(); });

})();
</script>
